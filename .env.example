# Environment variables
# Copy this file to .env and fill in the values

# Database connection
DATABASE_URL="postgresql://username:password@localhost:5432/egc_conference_app"

# Next Auth
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Email service (for sending registration confirmations and ID cards)
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=no-reply@example.com

# WhatsApp API (for team group invitations)
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_API_URL="https://api.example.com/whatsapp"

# Socket.io configuration
SOCKET_SERVER_URL="http://localhost:3000"

# App configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EGC Conference"
