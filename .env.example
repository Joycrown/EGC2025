# Copy this file to .env and fill in real values.
# NEVER put real keys or passwords in this file — it is committed to git.

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL=https://egc.gofamintpsakure.org

# Environment - Set to 'production' to use Neon database, 'development' or empty for local database
APP_ENV=development

# Database - local PostgreSQL for development
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/egcApp

# Production database (Neon) — only needed to run maintenance scripts against prod
PROD_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT — any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# Email (Brevo)
# BREVO_API_KEY: Brevo dashboard → SMTP & API → API Keys → "Generate a new API key" (starts with xkeysib-)
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Sender address — must be a verified sender/domain in Brevo
EMAIL_USER=no-reply@gofamintpsakure.org

# WhatsApp Team Links
WHATSAPP_LINK_BETHEL=https://chat.whatsapp.com/your-bethel-invite
WHATSAPP_LINK_JUDAH=https://chat.whatsapp.com/your-judah-invite
WHATSAPP_LINK_SALEM=https://chat.whatsapp.com/your-salem-invite
WHATSAPP_LINK_SHILOH=https://chat.whatsapp.com/your-shiloh-invite

# Socket Server
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:3001
SOCKET_SERVER_URL=http://localhost:3001

# Agora (get from console.agora.io → your project → App ID & App Certificate)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# SEO
GOOGLE_SITE_VERIFICATION=your-google-site-verification-code
