generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tournament ────────────────────────────────────────────────────────────

enum TournamentStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  status      TournamentStatus @default(UPCOMING)
  startDate   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rounds      TournamentRound[]
  sessions    GameSession[]
}

model TournamentRound {
  id             String       @id @default(cuid())
  tournamentId   String
  weekNumber     Int
  gameType       EgcGameType
  scheduledDate  DateTime
  createdAt      DateTime     @default(now())
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sessions       GameSession[]
}

// ─── Conference Edition (multi-year support) ───────────────────────────────

model ConferenceEdition {
  id            String                   @id @default(cuid())
  year          Int                      @unique
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  attendance    Attendance[]
  events        ConferenceEvent[]
  gameSessions  GameSession[]
  registrations ConferenceRegistration[]
}

// Per-edition registration — one row per user per conference year
model ConferenceRegistration {
  id        String            @id @default(cuid())
  userId    String
  editionId String
  teamId    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  edition   ConferenceEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  team      Team?             @relation(fields: [teamId], references: [id])
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId])
}

// ─── Attendance ────────────────────────────────────────────────────────────

model Attendance {
  id          String             @id @default(cuid())
  userId      String
  editionId   String?
  createdAt   DateTime           @default(now())
  day1        Boolean            @default(false) @map("day_11_july")
  day2        Boolean            @default(false) @map("day_12_july")
  day3        Boolean            @default(false) @map("day_13_july")
  updatedAt   DateTime           @updatedAt
  userEmail   String?
  edition     ConferenceEdition? @relation(fields: [editionId], references: [id])
  User        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId])
}

// ─── Chat ─────────────────────────────────────────────────────────────────

model ChatMessage {
  id            String      @id @default(cuid())
  gameSessionId String
  userId        String
  message       String
  createdAt     DateTime    @default(now())
  GameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [userId], references: [id])
}

// ─── Conference Events ─────────────────────────────────────────────────────

model ConferenceEvent {
  id                String             @id @default(cuid())
  title             String
  description       String
  startTime         DateTime
  endTime           DateTime
  venue             String
  eventType         EventType
  editionId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  edition           ConferenceEdition? @relation(fields: [editionId], references: [id])
  SpeakerAssignment SpeakerAssignment[]
}

// ─── Games ────────────────────────────────────────────────────────────────

model Game {
  id                String              @id @default(cuid())
  name              String
  description       String?
  gameType          GameType
  startTime         DateTime
  endTime           DateTime?
  venue             String
  status            GameStatus          @default(SCHEDULED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  GameParticipation GameParticipation[]
  GameScore         GameScore[]
  Team              Team[]
}

model GameParticipation {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  position  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Game      Game     @relation(fields: [gameId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
}

model GameRoster {
  id            String      @id @default(cuid())
  gameSessionId String
  userId        String
  teamId        String
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([gameSessionId, userId])
}

model GameScore {
  id        String   @id @default(cuid())
  gameId    String
  teamName  String
  score     Int
  timestamp DateTime @default(now())
  updatedAt DateTime @updatedAt
  Game      Game     @relation(fields: [gameId], references: [id])
}

model GameSession {
  id                String             @id @default(cuid())
  gameType          EgcGameType
  teamAId           String
  teamBId           String
  editionId         String?
  tournamentId      String?
  tournamentRoundId String?
  roundNumber       Int?               // 1 or 2 within a match
  poolAssignment    Json?              // pre-assigned word/question pool for no-repeat guarantee
  status            SessionStatus      @default(SCHEDULED)
  scheduledAt       DateTime
  startedAt         DateTime?
  endedAt           DateTime?
  teamAScore        Int                @default(0)
  teamBScore        Int                @default(0)
  currentTurnTeamId String?
  winnerId          String?
  gameState         Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chat              ChatMessage[]
  roster            GameRoster[]
  edition           ConferenceEdition? @relation(fields: [editionId], references: [id])
  tournament        Tournament?        @relation(fields: [tournamentId], references: [id])
  tournamentRound   TournamentRound?   @relation(fields: [tournamentRoundId], references: [id])
  teamA             Team               @relation("GameSession_teamAIdToTeam", fields: [teamAId], references: [id])
  teamB             Team               @relation("GameSession_teamBIdToTeam", fields: [teamBId], references: [id])
  winner            Team?              @relation("GameSession_winnerIdToTeam", fields: [winnerId], references: [id])
  turns             TurnLog[]
}

// ─── Speakers ─────────────────────────────────────────────────────────────

model Speaker {
  id                String              @id @default(cuid())
  name              String
  bio               String?
  image             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  SpeakerAssignment SpeakerAssignment[]
}

model SpeakerAssignment {
  id              String          @id @default(cuid())
  eventId         String
  speakerId       String
  role            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ConferenceEvent ConferenceEvent @relation(fields: [eventId], references: [id])
  Speaker         Speaker         @relation(fields: [speakerId], references: [id])

  @@unique([eventId, speakerId])
}

// ─── Teams ────────────────────────────────────────────────────────────────

model Team {
  id                String                   @id @default(cuid())
  name              String                   @unique
  color             String
  logo              String?
  points            Int                      @default(0)
  wins              Int                      @default(0)
  losses            Int                      @default(0)
  draws             Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  roster            GameRoster[]
  registrations     ConferenceRegistration[]
  teamAGameSessions GameSession[]            @relation("GameSession_teamAIdToTeam")
  teamBGameSessions GameSession[]            @relation("GameSession_teamBIdToTeam")
  wonGameSessions   GameSession[]            @relation("GameSession_winnerIdToTeam")
  users             User[]
  Game              Game[]
}

// ─── Turn Logs ────────────────────────────────────────────────────────────

model TurnLog {
  id            String      @id @default(cuid())
  gameSessionId String
  teamId        String
  userId        String?
  moveData      Json
  isCorrect     Boolean?
  pointsAwarded Int         @default(0)
  timestamp     DateTime    @default(now())
  GameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id                      String                   @id
  email                   String?                  @unique
  password                String
  fullName                String
  phoneNumber             String?
  birthDate               Int?
  birthMonth              Int?
  gender                  String
  isVerified              Boolean                  @default(false)
  isChild                 Boolean                  @default(false)
  verificationToken       String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  role                    Role                     @default(PARTICIPANT)
  teamId                  String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  teamName                String?
  userType                UserType                 @default(USER)
  address                 String?
  attendances             Attendance[]
  ChatMessage             ChatMessage[]
  conferenceRegistrations ConferenceRegistration[]
  GameParticipation       GameParticipation[]
  gameRosters             GameRoster[]
  Team                    Team?                    @relation(fields: [teamId], references: [id])
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum EgcGameType {
  HANGMAN
  WORD_SCRAMBLE
  TIC_TAC_TOE
  SUDOKU_RELAY
  CROSSWORD
  WORD_CHAIN
  BIBLE_VERSE_COMPLETION
  WORD_BLITZ
  NAME_THAT_TUNE
  BIBLE_TRIVIA
  SCRIPTURE_SCRAMBLE
  BIBLE_CATEGORIES
  CONNECT_THE_DOTS
}

enum EventType {
  GENERAL_SESSION
  WORKSHOP
  BREAKOUT
  MEAL
  GAME
  SPECIAL
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GameType {
  FOOTBALL
  VOLLEYBALL
  BASKETBALL
  QUIZ
  RELAY_RACE
  TUG_OF_WAR
  OTHER
}

enum Role {
  ADMIN
  COORDINATOR
  PARTICIPANT
  VOLUNTEER
  SUPER_ADMIN
  MINISTER
  MEMBER
  INVITEE
  CHILD
}

enum SessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserType {
  SUPER_ADMIN
  ADMIN
  USER
}
